# Docker Compose development overrides. Copy to .env in the repository root.
# Container addresses and ports are defined in compose.dev.yaml.
DB_NAME=pms
DB_PASSWORD=pms-development

# SMTP is external to Compose; configure a reachable mail server.
SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# API containers use the Compose Redis service, not localhost.
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=pms:

# Maximum SDK ingestion requests per minute.
SDK_RATE_LIMIT_PER_MINUTE=120

# Scheduled monitoring-data cleanup: disabled in development, enabled in production.
RETENTION_ENABLED=false
# Retention period in days, cleanup interval in minutes, records per batch.
RETENTION_DAYS=30
RETENTION_INTERVAL_MINUTES=60
RETENTION_BATCH_SIZE=5000
