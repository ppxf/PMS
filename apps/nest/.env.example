NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MONITORING_PUBLIC_URL=http://localhost:3001

DB_ENABLED=true
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=pms
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Production secrets must be replaced. JWT_SECRET must contain at least 32 characters.
JWT_SECRET=development-only-jwt-secret-change-before-production
JWT_EXPIRES_IN=1h
EMAIL_VERIFICATION_EXPIRES_IN_MINUTES=1440
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PMS <no-reply@localhost>

SWAGGER_ENABLED=true
SWAGGER_PATH=docs
