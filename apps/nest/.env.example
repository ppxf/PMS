NODE_ENV=development
PORT=3000
API_PREFIX=api

DB_ENABLED=true
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=pms
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Production secrets must be replaced. JWT_SECRET must contain at least 32 characters.
JWT_SECRET=development-only-jwt-secret-change-before-production
JWT_EXPIRES_IN=1h

SWAGGER_ENABLED=true
SWAGGER_PATH=docs
