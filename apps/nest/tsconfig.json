{
  "extends": "@pms/config/typescript",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "dist-dev"
  ]
}
