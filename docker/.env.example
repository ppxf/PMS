# Copy to docker/.env.production and replace all CHANGE_ME values.
HTTP_PORT=8080
# Browser -> controlled HTTPS ingress -> Nginx -> API.
# The HTTPS ingress must overwrite X-Forwarded-For with the client IP.
TRUST_PROXY_HOPS=2
DB_USERNAME=pms
DB_NAME=pms
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_FRONTEND_URL=https://pms.example.com
CORS_ORIGINS=https://pms.example.com
PUBLIC_URL=https://pms.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=no-reply@example.com
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=pms:
SDK_RATE_LIMIT_PER_MINUTE=120
RETENTION_ENABLED=true
RETENTION_DAYS=30
RETENTION_INTERVAL_MINUTES=60
RETENTION_BATCH_SIZE=5000
