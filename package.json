{
  "name": "pms-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --ui=stream",
    "docker:dev": "docker compose -f compose.dev.yaml up --build -d",
    "sdk:install": "pnpm --dir packages install --frozen-lockfile",
    "sdk:build": "pnpm --dir packages build",
    "sdk:test": "pnpm --dir packages test",
    "sdk:typecheck": "pnpm --dir packages typecheck",
    "sdk:lint": "pnpm --dir packages lint",
    "docker:production": "docker compose --env-file docker/.env.production -f compose.production.yaml up --build -d",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
