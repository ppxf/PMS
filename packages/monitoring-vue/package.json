{
  "name": "@pms/monitoring-vue",
  "version": "0.1.0",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "vue": ">=3.3 <4"
  },
  "devDependencies": {
    "@pms/config": "workspace:*",
    "@pms/monitoring-core": "workspace:*",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.40"
  },
  "engines": { "node": "^22.18.0 || >=24.12.0" }
}
